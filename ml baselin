"""
Обучение и проверка ML baseline (DWI+ADC+FLAIR -> RandomForest) на РЕАЛЬНОМ
датасете ISLES-2022 (BIDS-структура), а не на синтетике.

ОЖИДАЕМАЯ СТРУКТУРА (как в оригинальном датасете ISLES-2022):

    <data_dir>/
        rawdata/
            sub-strokecase0001/
                ses-0001/
                    dwi/
                        sub-strokecase0001_ses-0001_dwi.nii.gz
                        sub-strokecase0001_ses-0001_adc.nii.gz
                    anat/
                        sub-strokecase0001_ses-0001_FLAIR.nii.gz
            sub-strokecase0002/
                ...
        derivatives/
            sub-strokecase0001/
                ses-0001/
                    sub-strokecase0001_ses-0001_msk.nii.gz
            sub-strokecase0002/
                ...

Данные должны лежать ЛОКАЛЬНО (скачайте папку с Google Диска на машину,
где будете обучать модель — сам скрипт с Google Диском не работает,
он читает файлы с диска компьютера через обычный filesystem).

Поддерживаемые форматы томов: .nii / .nii.gz (нужен nibabel) и .npy.
Каждый 3D-том режется на 2D-срезы — обучение и метрики считаются посрезово.

Разбиение на train/val/test — ПО ПАЦИЕНТАМ (case), а не по срезам,
чтобы избежать утечки данных (срезы одного пациента похожи друг на друга).

Запуск:
    python3 train_on_dataset.py --data-dir /path/to/ISLES-2022
    python3 train_on_dataset.py --data-dir /path/to/ISLES-2022 --no-flair
"""

import argparse
import random
from pathlib import Path

import numpy as np
from scipy import ndimage
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import roc_auc_score


# ---------------------------------------------------------------------------
# Загрузка томов
# ---------------------------------------------------------------------------

def load_volume(path: Path) -> np.ndarray:
    """Загружает .npy или .nii/.nii.gz как numpy-массив."""
    if path.suffix == ".npy":
        return np.load(path).astype(np.float32)
    if path.suffixes[-2:] == [".nii", ".gz"] or path.suffix == ".nii":
        try:
            import nibabel as nib
        except ImportError as e:
            raise ImportError(
                "Для чтения .nii/.nii.gz нужен nibabel: "
                "pip install nibabel --break-system-packages"
            ) from e
        return nib.load(str(path)).get_fdata().astype(np.float32)
    raise ValueError(f"Неизвестный формат файла: {path}")


def _first_existing(*candidates: Path):
    for c in candidates:
        if c.exists():
            return c
    return None


def discover_cases(data_dir: Path, require_flair: bool) -> list:
    """
    Находит все случаи в структуре ISLES-2022:
    <data_dir>/rawdata/sub-strokecaseXXXX/ses-0001/{dwi,anat}/...
    <data_dir>/derivatives/sub-strokecaseXXXX/ses-0001/..._msk.nii.gz

    Принимает файлы как в .nii.gz, так и в .npy (для отладки без nibabel).
    """
    rawdata_dir = data_dir / "rawdata"
    derivatives_dir = data_dir / "derivatives"
    if not rawdata_dir.exists() or not derivatives_dir.exists():
        raise SystemExit(
            f"Не найдены папки rawdata/ и derivatives/ внутри {data_dir}. "
            "Проверьте, что путь указывает на корень ISLES-2022."
        )

    cases = []
    for sub_dir in sorted(p for p in rawdata_dir.iterdir() if p.is_dir()):
        case_id = sub_dir.name  # например, sub-strokecase0001
        ses_dirs = sorted(p for p in sub_dir.iterdir() if p.is_dir())
        if not ses_dirs:
            continue
        ses_dir = ses_dirs[0]  # берём первую (обычно единственную) сессию
        ses_id = ses_dir.name  # ses-0001

        dwi_stem = ses_dir / "dwi" / f"{case_id}_{ses_id}_dwi"
        adc_stem = ses_dir / "dwi" / f"{case_id}_{ses_id}_adc"
        flair_stem = ses_dir / "anat" / f"{case_id}_{ses_id}_FLAIR"
        mask_stem = derivatives_dir / case_id / ses_id / f"{case_id}_{ses_id}_msk"

        dwi_path = _first_existing(dwi_stem.with_suffix(".nii.gz"), dwi_stem.with_suffix(".npy"))
        adc_path = _first_existing(adc_stem.with_suffix(".nii.gz"), adc_stem.with_suffix(".npy"))
        flair_path = _first_existing(flair_stem.with_suffix(".nii.gz"), flair_stem.with_suffix(".npy"))
        mask_path = _first_existing(mask_stem.with_suffix(".nii.gz"), mask_stem.with_suffix(".npy"))

        if dwi_path is None or adc_path is None:
            print(f"[пропуск] {case_id}: не хватает dwi/adc")
            continue
        if mask_path is None:
            print(f"[пропуск] {case_id}: нет маски в derivatives/")
            continue
        if require_flair and flair_path is None:
            print(f"[пропуск] {case_id}: нет FLAIR (используйте --no-flair)")
            continue

        cases.append({
            "case_id": case_id,
            "dwi": dwi_path, "adc": adc_path,
            "mask": mask_path, "flair": flair_path,
        })
    return cases


def volume_to_slices(case: dict, require_flair: bool):
    """Режет 3D-тома случая на 2D-срезы вдоль последней оси."""
    dwi = load_volume(case["dwi"])
    adc = load_volume(case["adc"])
    mask = load_volume(case["mask"])
    flair = load_volume(case["flair"]) if require_flair else None

    n_slices = dwi.shape[-1]
    slices = []
    for i in range(n_slices):
        m = (mask[..., i] > 0).astype(np.uint8)
        # пропускаем пустые срезы без мозга (только фон/шум по краям тома)
        if dwi[..., i].std() < 1e-6:
            continue
        slices.append({
            "case_id": case["case_id"],
            "dwi": dwi[..., i],
            "adc": adc[..., i],
            "flair": flair[..., i] if require_flair else None,
            "mask": m,
        })
    return slices


# ---------------------------------------------------------------------------
# Признаки (как в ml_baseline_flair.py, с опциональным FLAIR)
# ---------------------------------------------------------------------------

def _local_stats(img: np.ndarray, window: int = 5):
    mean = ndimage.uniform_filter(img, size=window)
    mean_sq = ndimage.uniform_filter(img ** 2, size=window)
    std = np.sqrt(np.clip(mean_sq - mean ** 2, 0, None))
    return mean, std


def extract_features(dwi, adc, flair=None, window: int = 5) -> np.ndarray:
    mean_dwi, std_dwi = _local_stats(dwi, window)
    mean_adc, std_adc = _local_stats(adc, window)

    feats = [dwi, adc, mean_dwi, std_dwi, mean_adc, std_adc]

    if flair is not None:
        mean_flair, std_flair = _local_stats(flair, window)
        dwi_norm = (dwi - dwi.mean()) / (dwi.std() + 1e-6)
        flair_norm = (flair - flair.mean()) / (flair.std() + 1e-6)
        mismatch = dwi_norm - flair_norm
        feats += [flair, mean_flair, std_flair, mismatch]

    stacked = np.stack(feats, axis=-1)
    return stacked.reshape(-1, stacked.shape[-1])


# ---------------------------------------------------------------------------
# Метрики
# ---------------------------------------------------------------------------

def dice_coefficient(pred, target, eps=1e-6):
    pred, target = pred.astype(bool), target.astype(bool)
    intersection = np.logical_and(pred, target).sum()
    return (2 * intersection + eps) / (pred.sum() + target.sum() + eps)


def iou_score(pred, target, eps=1e-6):
    pred, target = pred.astype(bool), target.astype(bool)
    intersection = np.logical_and(pred, target).sum()
    union = np.logical_or(pred, target).sum()
    return (intersection + eps) / (union + eps)


def find_best_threshold(proba_maps, masks, candidates=None):
    if candidates is None:
        candidates = np.arange(0.1, 0.95, 0.05)
    best_threshold, best_dice = 0.5, -1.0
    for t in candidates:
        scores = [dice_coefficient((p > t).astype(np.uint8), m)
                  for p, m in zip(proba_maps, masks)]
        mean_dice = np.mean(scores)
        if mean_dice > best_dice:
            best_dice, best_threshold = mean_dice, t
    return best_threshold, best_dice


# ---------------------------------------------------------------------------
# Разбиение по пациентам + обучение + оценка
# ---------------------------------------------------------------------------

def split_cases(case_ids: list, val_frac=0.15, test_frac=0.15, seed=0):
    rng = random.Random(seed)
    ids = case_ids.copy()
    rng.shuffle(ids)
    n = len(ids)
    n_val = max(1, int(n * val_frac))
    n_test = max(1, int(n * test_frac))
    test_ids = ids[:n_test]
    val_ids = ids[n_test:n_test + n_val]
    train_ids = ids[n_test + n_val:]
    return train_ids, val_ids, test_ids


def build_feature_matrix(slices, require_flair):
    X, y = [], []
    for s in slices:
        X.append(extract_features(s["dwi"], s["adc"], s["flair"] if require_flair else None))
        y.append(s["mask"].reshape(-1))
    return np.concatenate(X, axis=0), np.concatenate(y, axis=0)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--data-dir", type=Path, required=True,
                         help="Папка с case_XXX/ поддиректориями")
    parser.add_argument("--no-flair", action="store_true",
                         help="Не использовать FLAIR (если его нет в данных)")
    parser.add_argument("--seed", type=int, default=0)
    args = parser.parse_args()

    require_flair = not args.no_flair

    cases = discover_cases(args.data_dir, require_flair)
    if len(cases) < 3:
        raise SystemExit(
            f"Найдено всего {len(cases)} подходящих случаев в {args.data_dir}. "
            "Нужно минимум 3 (train/val/test) — проверьте структуру папок."
        )
    print(f"Найдено случаев: {len(cases)}")

    case_ids = [c["case_id"] for c in cases]
    train_ids, val_ids, test_ids = split_cases(case_ids, seed=args.seed)
    by_id = {c["case_id"]: c for c in cases}
    print(f"Train: {len(train_ids)}  Val: {len(val_ids)}  Test: {len(test_ids)}")

    train_slices = sum((volume_to_slices(by_id[cid], require_flair) for cid in train_ids), [])
    val_slices = sum((volume_to_slices(by_id[cid], require_flair) for cid in val_ids), [])
    test_slices = sum((volume_to_slices(by_id[cid], require_flair) for cid in test_ids), [])
    print(f"Срезов: train={len(train_slices)} val={len(val_slices)} test={len(test_slices)}")

    X_train, y_train = build_feature_matrix(train_slices, require_flair)

    clf = RandomForestClassifier(
        n_estimators=200, max_depth=12, class_weight="balanced",
        n_jobs=-1, random_state=args.seed,
    )
    clf.fit(X_train, y_train)

    # --- подбор порога на валидации ---
    val_proba, val_masks = [], []
    for s in val_slices:
        feats = extract_features(s["dwi"], s["adc"], s["flair"] if require_flair else None)
        proba = clf.predict_proba(feats)[:, 1].reshape(s["mask"].shape)
        val_proba.append(proba)
        val_masks.append(s["mask"])
    best_threshold, best_val_dice = find_best_threshold(val_proba, val_masks)
    print(f"\nЛучший порог (по валидации): {best_threshold:.2f}  "
          f"(Dice на валидации: {best_val_dice:.3f})")

    # --- финальная оценка на тесте ---
    dice_scores, iou_scores, auc_scores = [], [], []
    for s in test_slices:
        feats = extract_features(s["dwi"], s["adc"], s["flair"] if require_flair else None)
        proba = clf.predict_proba(feats)[:, 1]
        pred = (proba > best_threshold).astype(np.uint8).reshape(s["mask"].shape)

        dice_scores.append(dice_coefficient(pred, s["mask"]))
        iou_scores.append(iou_score(pred, s["mask"]))
        if s["mask"].sum() > 0:  # AUC не определён, если в срезе нет положительного класса
            auc_scores.append(roc_auc_score(s["mask"].reshape(-1), proba))

    print(f"\nРезультат на тестовых случаях ({len(test_ids)} пациентов, "
          f"{len(test_slices)} срезов):")
    print(f"  Dice:    {np.mean(dice_scores):.3f}")
    print(f"  IoU:     {np.mean(iou_scores):.3f}")
    if auc_scores:
        print(f"  ROC-AUC: {np.mean(auc_scores):.3f}")


if __name__ == "__main__":
    main()
